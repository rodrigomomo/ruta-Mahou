  let currentLat = 36.7196;
  let currentLon = -4.4216;
  let currentFilter = 'todos';
  let mapInstance = null;
  let markersLayer = null;
  let qrStream = null;
  let qrScanInterval = null;

  window.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    if (params.get('scan') === '1') {
      buscarConGPS();
    }
  });

  function calcularDistanciaMetros(lat1, lon1, lat2, lon2) {
    const R = 6371e3;
    const p1 = lat1 * Math.PI / 180;
    const p2 = lat2 * Math.PI / 180;
    const dp = (lat2 - lat1) * Math.PI / 180;
    const dl = (lon2 - lon1) * Math.PI / 180;

    const a = Math.sin(dp / 2) * Math.sin(dp / 2) +
              Math.cos(p1) * Math.cos(p2) *
              Math.sin(dl / 2) * Math.sin(dl / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return Math.round(R * c);
  }

  function formatearDistancia(metros) {
    if (metros < 1000) return `${metros} m`;
    return `${(metros / 1000).toFixed(1)} km`;
  }

  // Enlace de navegación por coordenadas exactas hasta la puerta en Google Maps
  function generarEnlacePuertaGoogleMaps(bar) {
    return `https://www.google.com/maps/dir/?api=1&destination=${bar.lat},${bar.lon}&travelmode=walking`;
  }

  function inicializarMapa(lat, lon, bares) {
    if (!mapInstance) {
      mapInstance = L.map('realMap', { zoomControl: false }).setView([lat, lon], 15);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '© OpenStreetMap'
      }).addTo(mapInstance);
      markersLayer = L.layerGroup().addTo(mapInstance);
    } else {
      mapInstance.setView([lat, lon], 15);
      markersLayer.clearLayers();
    }

    const userIcon = L.divIcon({
      className: 'custom-user-pin',
      html: `<div style="width:16px;height:16px;background:#1A73E8;border:3px solid #fff;border-radius:50%;box-shadow:0 0 8px rgba(26,115,232,0.8);"></div>`,
      iconSize: [16, 16]
    });
    L.marker([lat, lon], { icon: userIcon }).addTo(markersLayer).bindPopup("Tu ubicación actual");

    bares.forEach(bar => {
      const mahouIcon = L.divIcon({
        className: 'custom-mahou-pin',
        html: `<div style="width:24px;height:24px;background:#C8102E;border:2px solid #fff;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,0.35);"><svg class="logo-white" viewBox="0 0 134 97.5" width="14" height="10.2"><use href="#mahou-m"/></svg></div>`,
        iconSize: [24, 24]
      });
      L.marker([bar.lat, bar.lon], { icon: mahouIcon })
        .addTo(markersLayer)
        .bindPopup(`<strong>${bar.nombre}</strong><br>${formatearDistancia(bar.distancia)}`);
    });

    setTimeout(() => {
      mapInstance.invalidateSize();
    }, 200);
  }

  function renderizarBares() {
    let lista = BARES_MALAGA.map(bar => {
      const dist = calcularDistanciaMetros(currentLat, currentLon, bar.lat, bar.lon);
      return { ...bar, distancia: dist };
    }).sort((a, b) => a.distancia - b.distancia);

    if (currentFilter === 'centro') {
      lista = lista.filter(b => b.zona === 'centro');
    } else if (currentFilter === 'barrios') {
      lista = lista.filter(b => b.zona === 'barrios');
    } else {
      lista = lista.slice(0, 6);
    }

    const container = document.getElementById('barsContainer');
    container.innerHTML = '';

    lista.forEach(bar => {
      const mapsUrl = generarEnlacePuertaGoogleMaps(bar);

      const itemHTML = `
        <div class="bar-card">
          <div class="bar-details">
            <div class="bar-title">
              <span>📍</span> ${bar.nombre}
            </div>
            <div class="bar-address">${bar.direccion} – <strong>${formatearDistancia(bar.distancia)}</strong></div>
            <span class="bar-tag">${bar.especialidad}</span>
          </div>
          <a href="${mapsUrl}" target="_blank" rel="noopener noreferrer" class="bar-go-btn">Ir ➔</a>
        </div>
      `;
      container.innerHTML += itemHTML;
    });

    inicializarMapa(currentLat, currentLon, lista);
  }

  function mostrarPantallaChat(lat, lon, etiquetaModo, mensajeUsuario) {
    currentLat = lat;
    currentLon = lon;

    const ahora = new Date();
    const hora = ahora.getHours().toString().padStart(2, '0') + ':' + ahora.getMinutes().toString().padStart(2, '0');
    document.getElementById('currentTime').textContent = `${hora} ✓✓`;
    document.getElementById('locationModeLabel').textContent = etiquetaModo;
    document.getElementById('userBubbleText').textContent = mensajeUsuario;

    document.getElementById('loaderMsg').style.display = 'none';
    document.getElementById('landingView').style.display = 'none';
    document.getElementById('chatView').style.display = 'flex';

    renderizarBares();
  }

  function buscarConGPS() {
    const loader = document.getElementById('loaderMsg');
    loader.style.display = 'block';

    if (!navigator.geolocation) {
      simularZona('centro', 36.7196, -4.4216, 'Calle Larios, Centro');
      return;
    }

    navigator.geolocation.getCurrentPosition(
      (pos) => {
        mostrarPantallaChat(
          pos.coords.latitude,
          pos.coords.longitude,
          "Asistente de Mahou • GPS Activo",
          "📍 Mi ubicación GPS actual"
        );
      },
      () => {
        simularZona('centro', 36.7196, -4.4216, 'Calle Larios, Málaga (Modo Demo)');
      },
      { enableHighAccuracy: true, timeout: 7000 }
    );
  }

  function simularZona(zona, lat, lon, nombreLugar) {
    currentFilter = 'todos';
    actualizarChipsUI('chipTodos');
    mostrarPantallaChat(
      lat,
      lon,
      `Asistente de Mahou • ${nombreLugar}`,
      `📍 Estoy en ${nombreLugar}`
    );
  }

  async function abrirEscanerQR() {
    const modal = document.getElementById('qrModal');
    const video = document.getElementById('qrVideo');
    const canvas = document.getElementById('qrCanvas');
    const ctx = canvas.getContext('2d');
    const statusText = document.getElementById('qrStatusText');
    modal.style.display = 'flex';
    statusText.textContent = "Iniciando cámara...";

    try {
      qrStream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "environment" }
      });
      video.srcObject = qrStream;
      video.setAttribute("playsinline", true);
      await video.play();
      statusText.textContent = "Encuadra el código QR de Ruta Mahou...";

      qrScanInterval = setInterval(() => {
        if (video.readyState === video.HAVE_ENOUGH_DATA) {
          canvas.height = video.videoHeight;
          canvas.width = video.videoWidth;
          ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
          const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          if (typeof jsQR !== 'undefined') {
            const code = jsQR(imageData.data, imageData.width, imageData.height, {
              inversionAttempts: "dontInvert"
            });
            if (code && code.data) {
              statusText.style.color = "#25D366";
              statusText.textContent = "¡QR Detectado! Conectando GPS...";
              cerrarEscanerQR();
              buscarConGPS();
            }
          }
        }
      }, 250);
    } catch (err) {
      statusText.textContent = "No se pudo acceder a la cámara (requiere HTTPS). Pulsa 'Simular QR Escaneado'.";
    }
  }

  function cerrarEscanerQR() {
    document.getElementById('qrModal').style.display = 'none';
    if (qrScanInterval) clearInterval(qrScanInterval);
    if (qrStream) {
      qrStream.getTracks().forEach(track => track.stop());
      qrStream = null;
    }
  }

  function simularLecturaQR() {
    cerrarEscanerQR();
    buscarConGPS();
  }

  function actualizarChipsUI(activeId) {
    ['chipTodos', 'chipCentro', 'chipBarrios'].forEach(id => {
      document.getElementById(id).classList.remove('active');
    });
    document.getElementById(activeId).classList.add('active');
  }

  function filtrarLista(tipo) {
    currentFilter = tipo;
    if (tipo === 'todos') actualizarChipsUI('chipTodos');
    if (tipo === 'centro') actualizarChipsUI('chipCentro');
    if (tipo === 'barrios') actualizarChipsUI('chipBarrios');
    renderizarBares();
  }

  // ================= MOTOR CHATBOT BÁSICO OFICIAL MAHOU =================
  function agregarMensajeChat(texto, esUsuario = false) {
    const contenedorMensajes = document.getElementById('waMessagesScroll');
    const div = document.createElement('div');
    div.className = esUsuario ? 'msg-user' : 'msg-bot';
    
    const ahora = new Date();
    const hora = ahora.getHours().toString().padStart(2, '0') + ':' + ahora.getMinutes().toString().padStart(2, '0');
    
    if (esUsuario) {
      div.textContent = texto;
    } else {
      div.innerHTML = `
        <div style="line-height:1.45;">${texto}</div>
        <div class="msg-footer" style="margin-top:6px;">
          <span>¡Salud! 🍻</span>
          <span class="msg-time">${hora} ✓✓</span>
        </div>
      `;
    }
    
    contenedorMensajes.appendChild(div);
    contenedorMensajes.scrollTop = contenedorMensajes.scrollHeight;
  }

  // ================= MOTOR CHATBOT v2: MÁS PREGUNTAS SOBRE BARES =================
  let chatUltimaLista = [];   // nombres de la última lista mostrada (para "más opciones")
  let chatIndiceLista = 0;

  function normalizarTexto(s) {
    return String(s).toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "")
      .replace(/['’]/g, "").replace(/[^a-z0-9,\s]/g, " ").replace(/\s+/g, " ").trim();
  }

  const PALABRAS_GENERICAS = new Set(['bodega', 'bodegas', 'bar', 'casa', 'cerveceria', 'taberna', 'meson', 'burger', 'antigua', 'plaza', 'calle', 'los', 'las', 'del']);

  const ZONAS_CHAT = [
    { re: /\b(teatinos|fuente de colores|torre atalaya)\b/, etiqueta: 'Teatinos', test: b => /teatinos/.test(b.h) },
    { re: /\bnueva malaga\b/, etiqueta: 'Nueva Málaga', test: b => /nueva malaga/.test(b.h) },
    { re: /\b(martinez|maldonado)\b/, etiqueta: 'Martínez Maldonado', test: b => /martinez maldonado/.test(b.h) },
    { re: /\b(sostoa|carretera de cadiz)\b/, etiqueta: 'Héroe de Sostoa / Carretera de Cádiz', test: b => /sostoa|carretera de cadiz/.test(b.h) },
    { re: /\b(santa rosalia|campanillas)\b/, etiqueta: 'Santa Rosalía / Campanillas', test: b => /santa rosalia|campanillas/.test(b.h) },
    { re: /\b(ortega|gasset)\b/, etiqueta: 'Ortega y Gasset', test: b => /ortega/.test(b.h) },
    { re: /\b(calle granada|granada)\b/, etiqueta: 'la calle Granada', test: b => /c granada/.test(b.h) },
    { re: /\b(marin garcia)\b/, etiqueta: 'la calle Marín García', test: b => /marin garcia/.test(b.h) },
    { re: /\b(carreteria)\b/, etiqueta: 'la calle Carretería', test: b => /carreteria/.test(b.h) },
    { re: /\b(alameda)\b/, etiqueta: 'la Alameda Principal', test: b => /alameda/.test(b.h) }
  ];

  const TIPOS_CHAT = {
    burger: { txt: 'con hamburguesas', emoji: '🍔', test: b => /burger/.test(b.h + ' ' + b.e) },
    vistas: { txt: 'con vistas', emoji: '🔭', test: b => /vistas/.test(b.e) },
    tapas:  { txt: 'para tapear', emoji: '🍽️', test: b => /tapa|racion|gastronom|tapeo/.test(b.e) },
    comida: { txt: 'para comer', emoji: '🍽️', test: b => /tapa|racion|gastronom|tapeo|burger/.test(b.h + ' ' + b.e) },
    tercio: { txt: 'con tercios helados', emoji: '🧊', test: b => /tercio/.test(b.e) },
    grifo:  { txt: 'con Mahou de grifo', emoji: '🍺', test: b => /grifo|presion/.test(b.e) }
  };

  const PALABRAS_IGNORADAS = new Set(['para', 'donde', 'tienen', 'quiero', 'estoy', 'algun', 'alguno', 'bares', 'cerca', 'buscar', 'tomar', 'esta', 'estan', 'como', 'cual', 'cuales', 'una', 'unos', 'unas', 'por', 'con', 'sin', 'los', 'las', 'del', 'algo', 'muy', 'pero', 'tengo', 'puedo', 'puedes', 'dime', 'dame', 'mahou', 'malaga']);

  function prepararBares() {
    return BARES_MALAGA.map(b => {
      const base = b.nombre.replace(/\(.*?\)/g, '').replace(/['’]s\b/gi, '');
      const m = b.nombre.match(/\((.*?)\)/);
      return {
        ...b,
        dist: calcularDistanciaMetros(currentLat, currentLon, b.lat, b.lon),
        h: normalizarTexto(b.nombre + ' ' + b.direccion),
        e: normalizarTexto(b.especialidad),
        claves: normalizarTexto(base).split(' ').filter(w => w.length > 2 && !PALABRAS_GENERICAS.has(w)),
        sucursal: normalizarTexto(m ? m[1] : '').split(' ').filter(w => w.length > 3 && w !== 'malaga')
      };
    }).sort((a, b) => a.dist - b.dist);
  }

  function tarjetaBarHTML(bar) {
    const url = generarEnlacePuertaGoogleMaps(bar);
    return `
      <div class="bar-card">
        <div class="bar-details">
          <div class="bar-title">📍 ${bar.nombre}</div>
          <div class="bar-address">${bar.direccion} – <strong>${formatearDistancia(bar.dist)}</strong></div>
          <span class="bar-tag">${bar.especialidad}</span>
        </div>
        <a href="${url}" target="_blank" rel="noopener noreferrer" class="bar-go-btn">Ir ➔</a>
      </div>`;
  }

  function enlaceFichaMaps(bar) {
    return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(bar.nombre + ' Málaga')}`;
  }

  function chipsHTML(preguntas) {
    return `<div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:8px;">` +
      preguntas.map(p => `<button class="quick-prompt-btn" onclick="enviarPreguntaRapida('${p}')">${p}</button>`).join('') +
      `</div>`;
  }

  function listaHTML(lista, intro, tam = 3) {
    chatUltimaLista = lista.map(b => b.nombre);
    chatIndiceLista = Math.min(tam, lista.length);
    const resto = lista.length - chatIndiceLista;
    let html = `${intro}<div class="bar-list" style="margin-top:8px;">${lista.slice(0, tam).map(tarjetaBarHTML).join('')}</div>`;
    if (resto > 0) {
      html += `<div style="font-size:11px;color:#667781;margin-top:6px;">Quedan ${resto} más en esta búsqueda.</div>` + chipsHTML(['Más opciones']);
    }
    return html;
  }

  function respuestaDatoNoDisponible(tipo, bar) {
    const intro = {
      horario: '🕒 No tengo los <strong>horarios</strong> de cada local en este asistente y no quiero darte uno equivocado.',
      precio: '💶 No tengo los <strong>precios</strong> de cada local en este asistente y no quiero darte uno equivocado.',
      reserva: '📞 No tengo <strong>teléfonos ni sistema de reservas</strong> de los locales en este asistente.',
      otro: '🤷 Ese dato (niños, mascotas, wifi, aparcamiento, accesibilidad, fútbol, pago con tarjeta…) no lo tengo registrado por local.'
    }[tipo];
    return `${intro}<br>Lo más fiable es mirar la ficha de <strong>${bar.nombre}</strong> en Google Maps, donde suele estar actualizado:<br><br>` +
      `<a href="${enlaceFichaMaps(bar)}" target="_blank" rel="noopener noreferrer" class="bar-go-btn">Ver ficha en Maps ➔</a>`;
  }

  function responderChatbotMahou(preguntaRaw) {
    const q = normalizarTexto(preguntaRaw);
    const bares = prepararBares();
    const cercano = bares[0];
    const porNombre = n => bares.find(b => b.nombre === n);
    const nPalabras = q === '' ? 0 : q.split(' ').length;

    // --- Bares nombrados en la pregunta (Casa Lola, El Pimpi, Rosario's + barrio...) ---
    let nombrados = bares.filter(b => b.claves.some(k => new RegExp('\\b' + k).test(q)));
    if (nombrados.length > 1) {
      const estrechados = nombrados.filter(b => b.sucursal.some(w => q.includes(w)));
      if (estrechados.length > 0) nombrados = estrechados;
    }
    const objetivo = nombrados[0] || cercano;

    // 1. Saludo
    if (/^(hola|ola|buenas|buenos dias|buenas tardes|buenas noches|hey|ey|que tal|saludos)\b/.test(q) && nPalabras <= 3) {
      return "¡Hola! 👋 Bienvenido a la <strong>Ruta Mahou Málaga</strong> ★★★★★.<br>Pregúntame por bares cercanos, por zona, con terraza, hamburguesas, tapas, vistas o cómo llegar." +
        chipsHTML(['¿Dónde tomar una Mahou?', '¿Tienen terraza?', 'Hamburguesas', 'Bares en el centro']);
    }

    // 2. Agradecimiento / despedida
    if (/\b(gracias|genial|perfecto|adios|chao|hasta luego|nos vemos|estupendo|guay)\b/.test(q) || /^(vale|ok|okey|de acuerdo)$/.test(q)) {
      return "¡A disfrutar de esa Mahou bien fresquita! 🍻 Si necesitas buscar otro bar más tarde, aquí estoy.";
    }

    // 3. Ayuda
    if (/\b(ayuda|que puedes|que sabes|que haces|que puedo preguntar|como funciona|que preguntas)\b/.test(q)) {
      return `🤝 Puedo ayudarte con:<br>
        • Bares <strong>más cercanos</strong> y <strong>cómo llegar</strong> (tiempo andando)<br>
        • Por <strong>zona</strong>: Centro, Teatinos, Nueva Málaga, Martínez Maldonado, Héroe de Sostoa, Santa Rosalía…<br>
        • <strong>Terraza</strong> o interior, <strong>hamburguesas</strong>, <strong>tapas</strong>, <strong>vistas</strong><br>
        • <strong>Tercios helados</strong>, Mahou de <strong>grifo</strong>, <strong>sin gluten</strong> y variedades<br>
        • Información de un bar por su nombre (ej. <em>«Casa Lola»</em>)<br>
        • <strong>Sorpréndeme</strong> si no sabes dónde ir` +
        chipsHTML(['Sorpréndeme', 'Terraza en Teatinos', '¿Cómo llego al más cercano?']);
    }

    // 4. Más opciones (continúa la última lista)
    if (/^(mas|otro|otra|otros|otras|siguiente|siguientes|y mas|y otro|y otra)( bar| opcion| local)?$/.test(q) ||
        /\b(mas opciones|otro bar|otra opcion|algun otro|dame mas|ensename mas|mas locales|mas bares)\b/.test(q)) {
      if (chatUltimaLista.length === 0) {
        return listaHTML(bares, '🍺 Aquí tienes los locales más cercanos a ti:');
      }
      const lista = chatUltimaLista.map(porNombre).filter(Boolean);
      const siguientes = lista.slice(chatIndiceLista, chatIndiceLista + 3);
      if (siguientes.length === 0) {
        return '👌 Ya te he enseñado todos los locales de esa búsqueda. Prueba con otra:' +
          chipsHTML(['¿Tienen terraza?', 'Hamburguesas', 'Bares en el centro', 'Sorpréndeme']);
      }
      chatIndiceLista += siguientes.length;
      const resto = lista.length - chatIndiceLista;
      return `➕ Más opciones:<div class="bar-list" style="margin-top:8px;">${siguientes.map(tarjetaBarHTML).join('')}</div>` +
        (resto > 0 ? `<div style="font-size:11px;color:#667781;margin-top:6px;">Quedan ${resto} más.</div>` + chipsHTML(['Más opciones']) : '');
    }

    // 5. Sorpréndeme
    if (/\b(sorprend\w*|al azar|aleatori\w*|cualquiera|me da igual|elige tu)\b/.test(q)) {
      const elegido = bares[Math.floor(Math.random() * bares.length)];
      return `🎲 Plan sorpresa: te toca <strong>${elegido.nombre}</strong>.<div class="bar-list" style="margin-top:8px;">${tarjetaBarHTML(elegido)}</div>` +
        chipsHTML(['Sorpréndeme']);
    }

    // 6. Datos que el asistente no tiene (honestidad: no inventar)
    if (/\b(abiert\w*|abre|abren|cierra|cierran|horario\w*|a que hora|hasta que hora)\b/.test(q)) return respuestaDatoNoDisponible('horario', objetivo);
    if (/\b(precio\w*|cuesta|cuestan|caro|cara|barato|barata|economic\w*|cuanto vale|menu del dia)\b/.test(q)) return respuestaDatoNoDisponible('precio', objetivo);
    if (/\b(reserv\w*|telefono|llamar|contacto|mesa para)\b/.test(q)) return respuestaDatoNoDisponible('reserva', objetivo);
    if (/\b(ninos|nino|familia|perro|perros|mascota\w*|wifi|aparca\w*|parking|accesib\w*|silla de ruedas|musica|futbol|partido|tarjeta|pagar|cumpleanos|grupo grande)\b/.test(q)) return respuestaDatoNoDisponible('otro', objetivo);

    // 7. Cómo llegar / distancia
    if (/\b(como llego|como ir|como se llega|llegar|indicaciones|donde esta|donde queda|andando|caminando|a pie|cuanto tardo|cuanto se tarda|distancia|metros)\b/.test(q)) {
      const min = Math.max(1, Math.round(objetivo.dist / 80));
      return `🚶 <strong>${objetivo.nombre}</strong> está a unos <strong>${formatearDistancia(objetivo.dist)}</strong> en línea recta, aproximadamente <strong>${min} min andando</strong> (estimación a ritmo normal). Te llevo hasta la puerta:` +
        `<div class="bar-list" style="margin-top:8px;">${tarjetaBarHTML(objetivo)}</div>`;
    }

    // 8. Recuentos y listado completo
    if (/\b(cuantos|cuantas|todos los|todas las|lista completa|listado|que bares hay|que locales hay|todos)\b/.test(q)) {
      const centro = bares.filter(b => b.zona === 'centro').length;
      const barrios = bares.length - centro;
      const terrazas = bares.filter(b => b.terraza).length;
      return listaHTML(bares, `🗺️ En la Ruta Mahou Málaga hay <strong>${bares.length}</strong> locales: <strong>${centro}</strong> en el Centro Histórico y <strong>${barrios}</strong> en los barrios. <strong>${terrazas}</strong> tienen terraza. Empezando por el más cercano:`, 4);
    }

    // 9. El más lejano
    if (/\b(mas lejos|mas lejano|lejano|lejana)\b/.test(q)) {
      const lejano = bares[bares.length - 1];
      return `🧭 El local más lejano de tu posición actual es <strong>${lejano.nombre}</strong>, a <strong>${formatearDistancia(lejano.dist)}</strong>:<div class="bar-list" style="margin-top:8px;">${tarjetaBarHTML(lejano)}</div>` +
        chipsHTML(['¿Cuál está más cerca?']);
    }

    // 10. Ficha de un bar concreto por su nombre
    if (nombrados.length === 1) {
      const b = nombrados[0];
      const terrazaTxt = b.terraza ? '☀️ Tiene terraza.' : '🏠 Es de barra/interior (sin terraza).';
      return `📍 <strong>${b.nombre}</strong><br>${terrazaTxt} Está a <strong>${formatearDistancia(b.dist)}</strong> de ti.` +
        `<div class="bar-list" style="margin-top:8px;">${tarjetaBarHTML(b)}</div>`;
    }
    if (nombrados.length > 1) {
      return listaHTML(nombrados, `📍 He encontrado <strong>${nombrados.length}</strong> locales con ese nombre. De más cerca a más lejos:`);
    }

    // 11. Sin gluten
    if (/\b(gluten|celiac\w*|celiaquia)\b/.test(q)) {
      const conGluten = bares.filter(b => /gluten/.test(b.e));
      if (conGluten.length > 0) {
        return listaHTML(conGluten, '🌾 ¡Claro! Existe <strong>Mahou Cinco Estrellas Sin Gluten</strong>. Estos locales de la ruta lo tienen destacado, de más cerca a más lejos:');
      }
      return listaHTML(bares, '🌾 ¡Claro! Existe <strong>Mahou Cinco Estrellas Sin Gluten</strong>. No tengo confirmado por local cuáles la sirven, así que confírmalo en la barra. Los más cercanos:');
    }

    // 12. Variedades
    if (/\b(variedad\w*|tipos de|maestra|0,0|tostada|sin alcohol|que cervezas|que mahou|lupulo|marcas)\b/.test(q)) {
      return `⭐ En los locales de la <strong>Ruta Mahou</strong> puedes pedir:<br>• <strong>Mahou Cinco Estrellas</strong> (grifo o tercio helado)<br>• <strong>Mahou Maestra Doble Lúpulo</strong><br>• <strong>Mahou 0,0 Tostada</strong><br>• <strong>Mahou Cinco Estrellas Sin Gluten</strong><br><br>Dime <em>«¿Dónde tomar una Mahou?»</em> y te llevo directo a la puerta del más cercano.`;
    }

    // 13. Búsqueda con filtros combinables: zona + terraza + tipo de plan
    const filtros = {};
    const zona = ZONAS_CHAT.find(z => z.re.test(q));
    if (zona) filtros.zona = zona;
    else if (/\b(centro|historico|casco antiguo)\b/.test(q)) filtros.zona = { etiqueta: 'el Centro Histórico', test: b => b.zona === 'centro' };
    else if (/\b(barrio|barrios|afueras)\b/.test(q)) filtros.zona = { etiqueta: 'los barrios de Málaga', test: b => b.zona === 'barrios' };

    if (/\b(interior|sin terraza|barra|resguardad\w*|llueve|lluvia|dentro)\b/.test(q)) filtros.terraza = false;
    else if (/\b(terraz\w*|aire libre|exterior|al sol|sol|soleado|veladores)\b/.test(q)) filtros.terraza = true;

    if (/\b(burger|burgers|hamburgues\w*|hamburger\w*)\b/.test(q)) filtros.tipo = 'burger';
    else if (/\b(vistas|catedral|panoramic\w*)\b/.test(q)) filtros.tipo = 'vistas';
    else if (/\b(tapa|tapas|tapear|tapeo|racion|raciones|gastronomi\w*)\b/.test(q)) filtros.tipo = 'tapas';
    else if (/\b(comer|comida|hambre|cenar|cena|almorzar|almuerzo|picar)\b/.test(q)) filtros.tipo = 'comida';
    else if (/\b(tercio|tercios|helad\w*)\b/.test(q)) filtros.tipo = 'tercio';
    else if (/\b(grifo|grifos|tirad\w*|presion)\b/.test(q)) filtros.tipo = 'grifo';

    if (filtros.zona || filtros.terraza !== undefined || filtros.tipo) {
      let resultados = bares;
      if (filtros.zona) resultados = resultados.filter(filtros.zona.test);
      if (filtros.terraza !== undefined) resultados = resultados.filter(b => b.terraza === filtros.terraza);
      if (filtros.tipo) resultados = resultados.filter(TIPOS_CHAT[filtros.tipo].test);

      const partes = [];
      if (filtros.tipo) partes.push(TIPOS_CHAT[filtros.tipo].txt);
      if (filtros.terraza === true) partes.push('con terraza');
      if (filtros.terraza === false) partes.push('de barra, sin terraza');
      let desc = partes.join(' y ');
      if (filtros.zona) desc += (desc ? ' ' : '') + 'en ' + filtros.zona.etiqueta;
      const emoji = filtros.tipo ? TIPOS_CHAT[filtros.tipo].emoji : (filtros.terraza === true ? '☀️' : '📍');

      if (resultados.length === 0) {
        return `🙈 No tengo locales ${desc} en la ruta. Prueba con otra búsqueda:` +
          chipsHTML(['¿Dónde tomar una Mahou?', '¿Tienen terraza?', 'Bares en el centro', 'Sorpréndeme']);
      }
      const n = resultados.length;
      return listaHTML(resultados, `${emoji} He encontrado <strong>${n}</strong> local${n > 1 ? 'es' : ''} ${desc}, de más cerca a más lejos:`);
    }

    // 14. Cerca de mí / recomendación general
    if (/\b(donde|tomar|beber|cana|canas|cerveza|cervezas|cervecita|mahou|bar|bares|local|locales|sed|recomiend\w*|recomienda|cerca|cercano|cercana|plan|quedar|copa|birra|fresquita|fria|sugier\w*|que hay|mejor|mejores|valorad\w*|popular\w*|top)\b/.test(q)) {
      const nota = /\b(mejor|mejores|valorad\w*|popular\w*|top)\b/.test(q)
        ? 'No tengo valoraciones de clientes, así que te ordeno los locales por cercanía. ' : '';
      return listaHTML(bares, `🍺 ${nota}¡Tu próxima <strong>Mahou fresquita</strong> está a un paso! El local más cercano a ti es <strong>${cercano.nombre}</strong> (a solo <strong>${formatearDistancia(cercano.dist)}</strong>):`);
    }

    // 15. Búsqueda por palabras sueltas (nombre, calle, especialidad)
    const tokens = q.split(' ').filter(w => w.length > 3 && !PALABRAS_IGNORADAS.has(w));
    const puntuados = bares
      .map(b => ({ b, p: tokens.filter(t => (b.h + ' ' + b.e).includes(t)).length }))
      .filter(x => x.p > 0)
      .sort((x, y) => y.p - x.p || x.b.dist - y.b.dist)
      .map(x => x.b);
    if (puntuados.length > 0) {
      return listaHTML(puntuados, `📍 He encontrado <strong>${puntuados.length}</strong> local${puntuados.length > 1 ? 'es' : ''} que encajan con tu búsqueda:`);
    }

    // 16. Sin coincidencias
    return 'No he pillado esa referencia 🍺. Puedes preguntarme, por ejemplo:' +
      chipsHTML(['¿Dónde tomar una Mahou?', '¿Tienen terraza?', 'Hamburguesas', 'Bares en el centro', 'Con vistas', 'Sorpréndeme']);
  }

  function enviarPreguntaRapida(texto) {
    agregarMensajeChat(texto, true);
    setTimeout(() => {
      const respuesta = responderChatbotMahou(texto);
      agregarMensajeChat(respuesta, false);
    }, 300);
  }

  function ejecutarBusquedaChat() {
    const input = document.getElementById('chatSearchInput');
    const val = input.value.trim();
    if (val === '') return;

    agregarMensajeChat(val, true);
    input.value = '';

    setTimeout(() => {
      const respuesta = responderChatbotMahou(val);
      agregarMensajeChat(respuesta, false);
    }, 350);
  }

  function volverPortada() {
    document.getElementById('chatView').style.display = 'none';
    document.getElementById('landingView').style.display = 'flex';
  }
</script>

</body>
</html>
