      <path d="M12,8 H48 C64,8 74,16 74,29 C74,39 68,46 58,49 L75,66 H56 L42,51 H28 V66 H12 Z M28,21 V38 H46 C53,38 58,35 58,29.5 C58,24 53,21 46,21 Z" fill="#231F20"/>
