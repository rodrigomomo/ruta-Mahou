    },
    {
      nombre: "La Taberna del Obispo",
      direccion: "Plaza del Obispo, 3 • Centro Histórico",
      zona: "centro",
      terraza: true,
      lat: 36.72021,
      lon: -4.42014,
      especialidad: "Vistas Catedral • Mahou Maestra"
    },
    {
      nombre: "Cervecería Los Gatos",
      direccion: "Plaza de Uncibay, 9 • Centro Histórico",
      zona: "centro",
      terraza: true,
      lat: 36.72352,
      lon: -4.42061,
      especialidad: "Cañas tiradas a presión"
    },
    {
      nombre: "La Tranca",
      direccion: "C/ Carretería, 92 • Centro Histórico",
      zona: "centro",
      terraza: false,
      lat: 36.72472,
      lon: -4.42223,
      especialidad: "Ambiente castizo • Mahou"
    },
