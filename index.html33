</svg>

<div class="app-shell">

  <!-- ==================== PANTALLA 1: CARTEL OFICIAL EXACTO RUTA MAHOU ==================== -->
  <div id="landingView" class="landing-view">
    
    <!-- SECCIÓN SUPERIOR DE 2 COLUMNAS IGUAL AL CARTEL -->
    <div class="poster-top-grid">
      
      <!-- COLUMNA IZQUIERDA: PIN 3D + MAPA ESPAÑA 3D + RUTA MAHOU -->
      <div class="poster-left-col">
        
        <!-- Pin Rojo Gigante con bisel de brillo y círculo blanco central -->
        <div class="hero-pin-wrapper" onclick="buscarConGPS()" title="Toca para conectar tu GPS y buscar tu Mahou">
          <svg class="hero-pin-svg" viewBox="0 0 210 255" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="pinBodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#E21B32"/>
                <stop offset="55%" stop-color="#C8102E"/>
                <stop offset="100%" stop-color="#9A0B1E"/>
              </linearGradient>
            </defs>
            <!-- Sombra exterior y cuerpo del pin -->
            <path d="M105 8 C49 8 10 49 10 100 C10 162 105 247 105 247 C105 247 200 162 200 100 C200 49 161 8 105 8 Z" fill="url(#pinBodyGrad)"/>
            <!-- Bisel interior de brillo 3D igual al cartel -->
            <path d="M105 14 C53 14 16 52 16 100 C16 157 105 237 105 237 C105 237 194 157 194 100 C194 52 157 14 105 14 Z" fill="none" stroke="#F04E5E" stroke-width="2" opacity="0.55"/>
            <!-- Círculo blanco interior -->
            <circle cx="105" cy="99" r="73" fill="#FFFFFF"/>
            <!-- Logo oficial "Mahou" con sus 5 estrellas dentro del pin -->
            <use href="#mahou-logo" class="logo-red" x="43" y="72" width="124" height="54.3"/>
          </svg>
        </div>

        <!-- Mapa de España 3D extruido en relieve beige con rutas discontinuas rojas y 7 chinchetas -->
        <svg class="spain-graphic" viewBox="0 0 390 185" xmlns="http://www.w3.org/2000/svg">
          <!-- Extrusión 3D lateral oscura (#C7AA84) -->
          <path d="M22,38 L42,27 L78,29 L115,24 L158,33 L195,36 L248,32 L292,43 L318,52 L310,68 L286,88 L272,115 L254,136 L235,152 L195,158 L152,163 L122,175 L100,165 L75,154 L66,134 L54,126 L47,96 L58,72 L40,66 L20,54 Z" fill="#C2A37B"/>
          <!-- Cara superior iluminada del mapa de España (#EEDAC0) -->
          <path d="M22,30 L42,19 L78,21 L115,16 L158,25 L195,28 L248,24 L292,35 L318,44 L310,60 L286,80 L272,107 L254,128 L235,144 L195,150 L152,155 L122,167 L100,157 L75,146 L66,126 L54,118 L47,88 L58,64 L40,58 L20,46 Z" fill="#EFE0C9" stroke="#DFC7A7" stroke-width="1"/>
          
          <!-- Islas Baleares en 3D -->
          <polygon points="325,112 333,108 336,115 327,118" fill="#C2A37B"/>
          <polygon points="325,108 333,104 336,111 327,114" fill="#EFE0C9"/>
          <polygon points="346,98 365,91 370,103 351,109" fill="#C2A37B"/>
          <polygon points="346,94 365,87 370,99 351,105" fill="#EFE0C9"/>
          <polygon points="376,88 386,85 388,92 378,95" fill="#C2A37B"/>
          <polygon points="376,84 386,81 388,88 378,91" fill="#EFE0C9"/>

          <!-- Líneas punteadas rojas de la ruta por España (exactas al cartel) -->
          <path d="M62,48 C85,68 110,65 155,75 C195,84 235,88 282,70" fill="none" stroke="#C8102E" stroke-width="2.2" stroke-dasharray="4.5,4.5"/>
          <path d="M90,115 C120,90 155,95 190,118 C220,136 245,126 264,136" fill="none" stroke="#C8102E" stroke-width="2.2" stroke-dasharray="4.5,4.5"/>
          <path d="M108,148 C135,145 162,140 198,122" fill="none" stroke="#C8102E" stroke-width="2.2" stroke-dasharray="4.5,4.5"/>

          <!-- Sombra bajo la punta del Pin Gigante central -->
          <ellipse cx="164" cy="96" rx="18" ry="6" fill="rgba(120,20,30,0.28)"/>

          <!-- 7 Chinchetas rojas repartidas por el mapa -->
          <g fill="#C8102E">
            <!-- Galicia -->
            <path d="M62,28 C56,28 52,32 52,38 C52,45 62,54 62,54 C62,54 72,45 72,38 C72,32 68,28 62,28 Z"/><circle cx="62" cy="38" r="3.2" fill="#fff"/>
            <!-- Norte / Castilla -->
            <path d="M114,38 C108,38 104,42 104,48 C104,55 114,64 114,64 C114,64 124,55 124,48 C124,42 120,38 114,38 Z"/><circle cx="114" cy="48" r="3.2" fill="#fff"/>
            <!-- Extremadura -->
            <path d="M88,94 C82,94 78,98 78,104 C78,111 88,120 88,120 C88,120 98,111 98,104 C98,98 94,94 88,94 Z"/><circle cx="88" cy="104" r="3.2" fill="#fff"/>
            <!-- Andalucía Occidental -->
            <path d="M98,130 C92,130 88,134 88,140 C88,147 98,156 98,156 C98,156 108,147 108,140 C108,134 104,130 98,130 Z"/><circle cx="98" cy="140" r="3.2" fill="#fff"/>
            <!-- Málaga / Andalucía Sur -->
            <path d="M156,120 C150,120 146,124 146,130 C146,137 156,146 156,146 C156,146 166,137 166,130 C166,124 162,120 156,120 Z"/><circle cx="156" cy="130" r="3.2" fill="#fff"/>
            <!-- Levante / Murcia -->
            <path d="M218,102 C212,102 208,106 208,112 C208,119 218,128 218,128 C218,128 228,119 228,112 C228,106 224,102 218,102 Z"/><circle cx="218" cy="112" r="3.2" fill="#fff"/>
            <!-- Aragón / Interior Este -->
            <path d="M238,65 C232,65 228,69 228,75 C228,82 238,91 238,91 C238,91 248,82 248,75 C248,69 244,65 238,65 Z"/><circle cx="238" cy="75" r="3.2" fill="#fff"/>
            <!-- Cataluña -->
            <path d="M268,48 C262,48 258,52 258,58 C258,65 268,74 268,74 C268,74 278,65 278,58 C278,52 274,48 268,48 Z"/><circle cx="268" cy="58" r="3.2" fill="#fff"/>
          </g>
        </svg>

        <!-- Títulos Calcados en SVG: "RUTA" (Sans-serif geométrica gruesa) y "Mahou" (Slab-serif condensada roja) -->
        <svg class="ruta-wordmark-svg" viewBox="0 0 300 72" aria-label="RUTA">
          <use href="#wordmark-ruta-photo"/>
        </svg>
        <svg class="mahou-wordmark-svg logo-red" viewBox="0 0 279.8 122.5" role="img" aria-label="Mahou ★★★★★">
          <use href="#mahou-logo"/>
        </svg>

        <!-- 5 Estrellas y Claim con líneas rojas exactas -->
        <div class="stars-divider-block">
          <div class="claim-lines-wrap">
            <div class="subtitle-claim">TU PRÓXIMA MAHOU FRESQUITA TE ESPERA</div>
          </div>
        </div>
      </div>

      <!-- COLUMNA DERECHA: LOS 4 BLOQUES VERTICALES DEL CARTEL -->
      <div class="poster-right-col">
        
        <!-- 1. RUTA MAHOU -->
        <div class="feature-item" onclick="buscarConGPS()">
          <div class="feature-icon">
            <svg viewBox="0 0 64 82" width="35" height="44">
              <path d="M32 2 C15 2 2 15 2 31 C2 51 32 79 32 79 C32 79 62 51 62 31 C62 15 49 2 32 2 Z" fill="#C8102E"/>
              <circle cx="32" cy="31" r="22" fill="#FFFFFF"/>
              <!-- "m" oficial con estrellas, en rojo sobre el círculo blanco -->
              <use href="#mahou-m-stars" class="logo-red" x="17" y="18" width="30" height="25.7"/>
            </svg>
          </div>
          <div class="feature-text">
            <h4>RUTA MAHOU</h4>
            <p>Descubre dónde disfrutar de una Mahou fresquita en toda España.</p>
          </div>
        </div>

        <!-- 2. ESCANEA -->
        <div class="feature-item" onclick="abrirEscanerQR()">
          <div class="feature-icon">
            <svg viewBox="0 0 56 80" width="32" height="44">
              <rect x="8" y="3" width="40" height="72" rx="6" fill="#FFFFFF" stroke="#C8102E" stroke-width="3.2"/>
              <line x1="8" y1="13" x2="48" y2="13" stroke="#C8102E" stroke-width="2.2"/>
              <line x1="23" y1="8" x2="33" y2="8" stroke="#C8102E" stroke-width="2" stroke-linecap="round"/>
              <line x1="8" y1="63" x2="48" y2="63" stroke="#C8102E" stroke-width="2.2"/>
              <circle cx="28" cy="69" r="2.3" fill="none" stroke="#C8102E" stroke-width="1.8"/>
              <!-- QR rojo detallado dentro del teléfono -->
              <rect x="15" y="21" width="9" height="9" fill="none" stroke="#C8102E" stroke-width="2"/>
              <rect x="18" y="24" width="3" height="3" fill="#C8102E"/>
              <rect x="32" y="21" width="9" height="9" fill="none" stroke="#C8102E" stroke-width="2"/>
              <rect x="35" y="24" width="3" height="3" fill="#C8102E"/>
              <rect x="15" y="38" width="9" height="9" fill="none" stroke="#C8102E" stroke-width="2"/>
              <rect x="18" y="41" width="3" height="3" fill="#C8102E"/>
              <rect x="27" y="21" width="3" height="6" fill="#C8102E"/>
              <rect x="15" y="33" width="12" height="3" fill="#C8102E"/>
              <rect x="31" y="33" width="10" height="3" fill="#C8102E"/>
              <rect x="28" y="39" width="5" height="5" fill="#C8102E"/>
              <rect x="36" y="38" width="5" height="9" fill="#C8102E"/>
              <rect x="27" y="47" width="8" height="3" fill="#C8102E"/>
            </svg>
          </div>
          <div class="feature-text">
            <h4>ESCANEA</h4>
            <p>Escanea el QR o escríbenos por WhatsApp.</p>
          </div>
        </div>

        <!-- 3. TE RESPONDEMOS -->
        <div class="feature-item" onclick="simularZona('centro', 36.7196, -4.4216, 'Calle Larios, Centro')">
          <div class="feature-icon">
            <svg viewBox="0 0 64 60" width="35" height="35">
              <path d="M32 6 C15 6 4 16 4 29 C4 35 7 41 13 45 L8 55 L21 50 C24.5 51.2 28.2 52 32 52 C49 52 60 41 60 29 C60 16 49 6 32 6 Z" fill="#FFFFFF" stroke="#C8102E" stroke-width="3.5" stroke-linejoin="round"/>
              <circle cx="21" cy="29" r="3.2" fill="#C8102E"/>
              <circle cx="32" cy="29" r="3.2" fill="#C8102E"/>
              <circle cx="43" cy="29" r="3.2" fill="#C8102E"/>
            </svg>
          </div>
          <div class="feature-text">
            <h4>TE RESPONDEMOS</h4>
            <p>Nuestro asistente automático te enviará los establecimientos más cercanos donde disfrutar una Mahou fresquita.</p>
          </div>
        </div>

        <!-- 4. DISFRUTA -->
        <div class="feature-item" onclick="buscarConGPS()">
          <div class="feature-icon">
            <svg viewBox="0 0 56 84" width="31" height="45">
              <!-- Caña Mahou roja con cuello y espuma blanca -->
              <path d="M14,22 L17,75 C17,78 20,80 28,80 C36,80 39,78 39,75 L42,22 Z" fill="#C8102E"/>
              <path d="M13,22 C10,17 13,11 19,11 C21,7 27,6 31,9 C36,7 41,9 42,14 C46,15 46,20 43,22 Z" fill="#FFFFFF" stroke="#C8102E" stroke-width="2.4"/>
              <use href="#mahou-m-stars" class="logo-white" x="17" y="34" width="22" height="18.8"/>
            </svg>
          </div>
          <div class="feature-text">
            <h4>DISFRUTA</h4>
            <p>Localiza, acércate y disfruta tu Mahou fresquita.</p>
          </div>
        </div>

      </div>
    </div>

    <!-- ==================== BANDA INFERIOR BEIGE CON LOS 3 PASOS EXACTOS DE LA FOTO ==================== -->
    <div class="bottom-poster-band">
      
      <!-- PASO 1: 1. ESCANEA EL QR -->
      <div class="poster-step-col">
        <div class="step-header-line">
          <div class="step-top-title">1. ESCANEA<br>EL QR</div>
