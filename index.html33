          <div class="qr-code-wrap"><svg xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Código QR de la Ruta Mahou" shape-rendering="crispEdges" style="width:100%;height:100%;display:block;" viewBox="0 0 37 37" class="segno"><path fill="#fff" d="M0 0h37v37h-37z"/><path class="qrline" stroke="#231f20" d="M2 2.5h7m2 0h1m2 0h1m1 0h3m1 0h2m2 0h2m2 0h7m-33 1h1m5 0h1m2 0h3m3 0h1m1 0h1m2 0h5m1 0h1m5 0h1m-33 1h1m1 0h3m1 0h1m7 0h2m1 0h1m1 0h2m2 0h2m1 0h1m1 0h3m1 0h1m-33 1h1m1 0h3m1 0h1m2 0h2m2 0h1m3 0h1m1 0h1m2 0h1m3 0h1m1 0h3m1 0h1m-33 1h1m1 0h3m1 0h1m2 0h4m3 0h2m1 0h1m3 0h1m2 0h1m1 0h3m1 0h1m-33 1h1m5 0h1m1 0h2m1 0h1m8 0h1m1 0h1m1 0h1m1 0h1m5 0h1m-33 1h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7m-24 1h3m2 0h1m2 0h5m-22 1h1m2 0h1m1 0h2m1 0h1m1 0h1m2 0h4m2 0h1m1 0h1m1 0h3m1 0h1m-28 1h1m2 0h3m1 0h1m1 0h1m1 0h1m2 0h1m1 0h1m1 0h1m1 0h1m3 0h4m3 0h2m-29 1h3m9 0h2m1 0h4m1 0h1m2 0h2m1 0h1m1 0h1m-33 1h1m1 0h1m1 0h2m1 0h1m2 0h3m1 0h2m1 0h1m3 0h1m1 0h1m4 0h2m1 0h2m-31 1h2m1 0h2m1 0h1m2 0h2m2 0h1m3 0h1m1 0h2m1 0h3m2 0h1m1 0h2m-32 1h2m1 0h1m2 0h3m2 0h1m2 0h3m6 0h3m1 0h2m1 0h2m-32 1h1m1 0h1m2 0h1m2 0h2m1 0h3m2 0h1m2 0h2m1 0h1m1 0h2m1 0h1m1 0h2m-32 1h2m7 0h4m1 0h2m1 0h1m1 0h1m1 0h2m3 0h4m1 0h1m-32 1h3m1 0h1m1 0h9m2 0h1m1 0h4m3 0h1m1 0h1m2 0h1m-30 1h2m1 0h1m1 0h3m1 0h1m2 0h1m1 0h1m3 0h1m2 0h2m2 0h1m1 0h1m-29 1h4m1 0h2m1 0h4m1 0h1m1 0h1m1 0h1m5 0h3m3 0h3m-33 1h1m1 0h2m3 0h2m2 0h2m4 0h5m1 0h3m1 0h1m3 0h1m-31 1h1m2 0h6m1 0h1m3 0h5m1 0h3m7 0h1m-30 1h2m1 0h1m1 0h2m1 0h1m4 0h2m1 0h3m1 0h1m1 0h3m3 0h3m-33 1h2m1 0h2m1 0h3m3 0h4m2 0h1m1 0h1m1 0h1m2 0h3m1 0h2m1 0h1m-32 1h1m2 0h1m2 0h2m2 0h1m1 0h2m1 0h1m4 0h5m1 0h1m1 0h1m1 0h2m-33 1h1m1 0h1m1 0h3m2 0h2m1 0h2m1 0h3m1 0h3m1 0h6m3 0h1m-25 1h2m2 0h3m1 0h1m1 0h7m3 0h2m1 0h2m-33 1h7m4 0h2m3 0h1m3 0h1m1 0h1m1 0h1m1 0h1m1 0h4m-32 1h1m5 0h1m1 0h1m1 0h1m2 0h2m4 0h4m1 0h1m3 0h1m2 0h2m-33 1h1m1 0h3m1 0h1m3 0h3m1 0h1m1 0h1m3 0h1m3 0h6m1 0h2m-33 1h1m1 0h3m1 0h1m1 0h1m3 0h4m3 0h2m2 0h2m1 0h1m1 0h3m-31 1h1m1 0h3m1 0h1m2 0h4m7 0h2m1 0h1m4 0h3m1 0h1m-33 1h1m5 0h1m2 0h2m4 0h4m2 0h1m2 0h3m-27 1h7m1 0h1m2 0h1m4 0h1m4 0h1m1 0h4m1 0h2m1 0h1"/></svg></div>
          <div class="qr-sticker-bottom">
            <span>O ESCRÍBENOS<br>POR WHATSAPP</span>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="#FFFFFF" stroke-width="2">
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2z"/>
              <path d="M9 9c.3-.6.6-.6 1-.6l.8 1.8c.1.3 0 .6-.2.9l-.4.5c.6 1 1.5 1.8 2.6 2.3l.5-.5c.3-.2.6-.3.9-.1l1.7.8c.1.4 0 .8-.5 1.1-.6.4-1.5.5-2.5.1-1.9-.7-3.4-2.2-4.1-4.1-.3-.9-.2-1.7.2-2.2z" fill="#FFFFFF" stroke="none"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- PASO 2: 2. TE RESPONDEMOS AL MOMENTO -->
      <div class="poster-step-col">
        <div class="step-header-line">
          <div class="step-top-title">2. TE RESPONDEMOS<br>AL MOMENTO</div>
          <svg class="step-red-arrow-svg" viewBox="0 0 24 16">
            <path d="M2,8 H20 M14,2 L21,8 L14,14" fill="none" stroke="#C8102E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="speech-bubble-card" onclick="simularZona('centro', 36.7196, -4.4216, 'Calle Larios, Centro')">
          <div>
            <div style="margin-bottom:4px;font-weight:600;">¡Hola! 👋</div>
            <div>Aquí tienes los locales más cercanos donde disfrutar tu Mahou fresquita:</div>
          </div>
          <div style="display:flex;justify-content:flex-end;margin-top:4px;">
            <svg viewBox="0 0 24 32" width="16" height="22">
              <path d="M12 1 C6 1 1 6 1 12 C1 20 12 31 12 31 C12 31 23 20 23 12 C23 6 18 1 12 1 Z" fill="#C8102E"/>
              <circle cx="12" cy="12" r="4.5" fill="#FFFFFF"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- PASO 3: 3. DISFRUTA TU MAHOU FRESQUITA -->
      <div class="poster-step-col">
        <div class="step-header-line">
          <div class="step-top-title">3. DISFRUTA<br>TU MAHOU FRESQUITA</div>
        </div>
        <div class="mini-phone-card" onclick="simularZona('centro', 36.7196, -4.4216, 'Calle Larios, Centro')" title="Toca para abrir el asistente interactivo de WhatsApp">
          <div class="mini-wa-head">
            <span style="font-size:8px;">←</span>
            <div style="width:15px;height:15px;border-radius:50%;background:#C8102E;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,0.6);">
              <svg class="logo-white" viewBox="0 0 134 97.5" width="9" height="6.5"><use href="#mahou-m"/></svg>
            </div>
            <div style="flex:1;">
              <div style="font-size:6.5px;font-weight:700;display:flex;align-items:center;gap:2px;">
                Ruta Mahou <span style="background:#25D366;color:#fff;border-radius:50%;width:7px;height:7px;display:inline-flex;align-items:center;justify-content:center;font-size:4.5px;">✓</span>
              </div>
              <div style="font-size:4.8px;opacity:0.85;">Asistente de Mahou</div>
            </div>
            <span style="font-size:8px;opacity:0.8;">⋮</span>
          </div>
          <div class="mini-wa-body">
            <div class="mini-wa-msg">
              <div>¡Hola! 👋</div>
              <div style="margin-bottom:3px;">Aquí tienes los locales más cercanos donde disfrutar tu Mahou fresquita:</div>
              <div style="margin-bottom:2px;"><span style="color:#C8102E;">📍</span> <strong>Bar La Esquina</strong><br><span style="color:#666;font-size:5px;">C/ Mayor, 12 – 210 m</span></div>
              <div style="margin-bottom:2px;"><span style="color:#C8102E;">📍</span> <strong>Cervecería El Sol</strong><br><span style="color:#666;font-size:5px;">C/ Libertad, 38 – 450 m</span></div>
              <div style="margin-bottom:3px;"><span style="color:#C8102E;">📍</span> <strong>Taberna Mahou</strong><br><span style="color:#666;font-size:5px;">C/ San Miguel, 5 – 750 m</span></div>
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <strong>¡Salud! 🍻</strong>
                <span style="color:#888;font-size:4.8px;">12:30</span>
              </div>
            </div>
            <div class="mini-wa-map">
              <!-- Calles simuladas del minimapa del cartel -->
              <svg viewBox="0 0 100 120" width="100%" height="100%" preserveAspectRatio="none">
                <rect width="100" height="120" fill="#F2EFE9"/>
                <polygon points="0,30 35,35 30,75 0,70" fill="#E3F0D8"/>
                <polygon points="55,65 95,65 95,105 55,105" fill="#D5EBC4"/>
                <path d="M0,20 L100,45 M25,0 L40,120 M70,0 L55,120 M0,85 L100,70" stroke="#FFFFFF" stroke-width="3.5"/>
                <!-- Punto azul GPS usuario -->
                <circle cx="48" cy="64" r="5" fill="#1A73E8" stroke="#FFFFFF" stroke-width="2"/>
                <!-- 3 Pines rojos como en la foto -->
                <path d="M32,16 C28,16 25,19 25,23 C25,28 32,35 32,35 C32,35 39,28 39,23 C39,19 36,16 32,16 Z" fill="#C8102E"/><circle cx="32" cy="23" r="2" fill="#fff"/>
                <path d="M74,12 C70,12 67,15 67,19 C67,24 74,31 74,31 C74,31 81,24 81,19 C81,15 78,12 74,12 Z" fill="#C8102E"/><circle cx="74" cy="19" r="2" fill="#fff"/>
                <path d="M84,54 C80,54 77,57 77,61 C77,66 84,73 84,73 C84,73 91,66 91,61 C91,57 88,54 84,54 Z" fill="#C8102E"/><circle cx="84" cy="61" r="2" fill="#fff"/>
              </svg>
            </div>
          </div>
          <div class="mini-wa-footer">
            <span>😊 Escribe un mensaje...</span>
            <span style="background:#0E695B;color:#fff;border-radius:50%;width:11px;height:11px;display:inline-flex;align-items:center;justify-content:center;font-size:6px;">🎤</span>
          </div>
        </div>
      </div>

    </div>

    <!-- ==================== PANEL INTERACTIVO DE PRUEBA GPS Y CHATBOT EN MÁLAGA ==================== -->
    <div class="cta-box">
      <button class="btn-primary" onclick="buscarConGPS()">
        <span>📍</span> ACTIVAR MI GPS Y ABRIR ASISTENTE MAHOU
      </button>

      <div class="action-row">
        <button class="btn-secondary" onclick="abrirEscanerQR()">
          <span>📷</span> Probar Escáner QR
        </button>
        <button class="btn-secondary" onclick="simularZona('centro', 36.7196, -4.4216, 'Calle Larios, Centro')">
          <span>💬</span> Probar Chatbot Málaga
        </button>
      </div>

      <div class="zone-pills">
        <div class="zone-label">O selecciona tu punto de partida en Málaga (Ruta hasta la puerta):</div>
        <button class="zone-pill" onclick="simularZona('centro', 36.7224, -4.4193, 'Centro Histórico')">Centro Histórico</button>
        <button class="zone-pill" onclick="simularZona('martinez', 36.7191, -4.4357, 'Martínez Maldonado')">M. Maldonado</button>
        <button class="zone-pill" onclick="simularZona('nuevamalaga', 36.7259, -4.4418, 'Nueva Málaga')">Nueva Málaga</button>
        <button class="zone-pill" onclick="simularZona('teatinos', 36.7219, -4.4819, 'Teatinos')">Teatinos</button>
        <button class="zone-pill" onclick="simularZona('sostoa', 36.6978, -4.4426, 'Héroe de Sostoa')">Héroe Sostoa</button>
        <button class="zone-pill" onclick="simularZona('santarosalia', 36.7347, -4.5446, 'Santa Rosalía')">Santa Rosalía</button>
      </div>

      <div id="loaderMsg" class="loader">Conectando satélite GPS y calculando metros exactos hasta la puerta...</div>
    </div>

  </div>

  <!-- ==================== MODAL ESCÁNER QR CON CÁMARA REAL ==================== -->
  <div id="qrModal" class="qr-modal">
    <h3 style="font-size:18px; font-weight:800;">Escáner QR Ruta Mahou</h3>
    <p style="font-size:12px; opacity:0.85; margin-top:4px;">Apunta la cámara al código QR de la mesa o cartel</p>
    <div class="scanner-frame">
      <video id="qrVideo" playsinline autoplay muted></video>
      <canvas id="qrCanvas" style="display:none;"></canvas>
      <div class="scan-line"></div>
    </div>
    <p id="qrStatusText" style="font-size:12px; font-weight:700; color:#ffd1d8; margin-bottom:12px;">Buscando código QR...</p>
    <div style="display:flex; gap:10px;">
      <button class="btn-primary" style="padding:10px 16px; font-size:12px;" onclick="simularLecturaQR()">
        ✓ Simular QR Escaneado
      </button>
      <button class="btn-secondary" style="padding:10px 16px; font-size:12px;" onclick="cerrarEscanerQR()">
        Cancelar
      </button>
    </div>
  </div>

  <!-- ==================== PANTALLA 2: ASISTENTE RUTA MAHOU (ESTILO WHATSAPP) ==================== -->
  <div id="chatView" class="chat-view">
    <div class="wa-topbar">
      <button class="wa-back" onclick="volverPortada()" title="Volver al cartel Ruta Mahou">
        ← Cartel
      </button>
      <div class="wa-avatar">
        <svg class="logo-white" viewBox="0 0 164.2 140.5" width="24" height="20.5"><use href="#mahou-m-stars"/></svg>
      </div>
      <div class="wa-info">
        <div class="wa-name">Ruta Mahou <span class="verified-badge">✓</span></div>
        <div class="wa-status" id="locationModeLabel">Asistente de Mahou • Málaga</div>
      </div>
    </div>

    <div class="wa-messages" id="waMessagesScroll">
      <div class="msg-user" id="userBubbleText">
        📍 Ubicación compartida
      </div>

      <div class="msg-bot">
        <div class="msg-bot-header" id="botGreetingText">
          ¡Hola! 👋<br>
          Aquí tienes los locales más cercanos donde disfrutar tu <strong>Mahou fresquita</strong>:
        </div>

        <div id="realMap"></div>

        <div class="chat-filters">
          <button class="filter-chip active" id="chipTodos" onclick="filtrarLista('todos')">Más cercanos</button>
          <button class="filter-chip" id="chipCentro" onclick="filtrarLista('centro')">Centro Histórico</button>
          <button class="filter-chip" id="chipBarrios" onclick="filtrarLista('barrios')">Barrios Málaga</button>
        </div>

        <div id="barsContainer" class="bar-list"></div>

        <div class="msg-footer">
          <span>¡Salud! 🍻</span>
          <span class="msg-time" id="currentTime">12:30 ✓✓</span>
        </div>

        <button onclick="volverPortada()" class="btn-volver-inicio">
          ← VOLVER AL CARTEL RUTA MAHOU
        </button>
      </div>
    </div>

    <!-- Botones rápidos de prueba del Chatbot Mahou -->
    <div class="quick-prompts">
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('¿Dónde tomar una Mahou?')">🍺 ¿Dónde tomar una Mahou?</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('¿Cuál está más cerca?')">📍 El más cercano</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('¿Cómo llego al más cercano?')">🚶 Cómo llegar</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('¿Tienen terraza?')">☀️ Terrazas</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('Hamburguesas')">🍔 Hamburguesas</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('¿Dónde comer tapas?')">🍽️ Tapas</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('Bares con vistas')">🔭 Con vistas</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('Bares en el centro')">🏛️ Centro</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('Tercios helados')">🧊 Tercios helados</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('Mahou sin gluten')">🌾 Sin gluten</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('Variedades Mahou')">⭐ Variedades</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('Sorpréndeme')">🎲 Sorpréndeme</button>
      <button class="quick-prompt-btn" onclick="enviarPreguntaRapida('Ayuda')">❓ Ayuda</button>
    </div>

    <!-- Barra inferior interactiva de WhatsApp -->
    <div class="wa-input-bar">
      <input type="text" id="chatSearchInput" class="wa-real-input" placeholder="Escribe un mensaje al Asistente Mahou..." onkeypress="if(event.key==='Enter') ejecutarBusquedaChat()" />
      <button class="wa-send-btn" onclick="ejecutarBusquedaChat()">➤</button>
    </div>
  </div>

</div>

<script>
  // BASE DE DATOS DE LOCALES EN MÁLAGA CON COORDENADAS GPS EXACTAS DE PUERTA
  const BARES_MALAGA = [
    {
